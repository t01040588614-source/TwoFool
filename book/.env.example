# Optional: PostgreSQL/MySQL 등을 사용할 때 설정합니다.
# DATABASE_URL=sqlite:///app.db

# 배포 환경에서는 충분히 길고 임의의 값으로 반드시 변경하세요.
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# 관제 대시보드 시드 계정 (미설정 시 서버 시작 로그에 임시 비밀번호 출력)
CONTROLLER_USERNAME=gygs1010
CONTROLLER_PASSWORD=change-this-controller-password
CONTROLLER_EMAIL=gygs1010@scmaglev.local

# Gmail SMTP 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com

# TossPayments 테스트 결제 설정 (토스 개발자센터 테스트 키)
TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_client_key
TOSS_PAYMENTS_SECRET_KEY=test_sk_your_secret_key
# 결제 모드: auto(키 있으면 결제창, 없으면 모의), 1(강제 모의), 0(강제 결제창)
TOSS_PAYMENTS_MOCK_ONLY=auto

# OpenAI — Key만 넣고 서버 재시작하면 자동 GPT 연동 (대시보드·승객 추천)
OPENAI_API_KEY=sk-your-openai-api-key-here
# 일반: gpt-4o-mini  |  학습(파인튜닝): ft:gpt-4o-mini:org:model-name:id
OPENAI_MODEL=gpt-4o-mini
# auto: Key 있으면 OpenAI / 1: Key 필수·항상 OpenAI / 0: 규칙 기반만
OPENAI_ENABLED=auto

# 대시보드 지도 추적 열차 상한 (Render 무료: 30~200 권장)
SCMAGLEV_MAX_TRACKED_TRAINS=200

# Render Docker 전용 (로컬 run_server.bat 에서는 자동으로 0 처리)
# SCMAGLEV_RENDER_LITE=1
# CONGESTION_DISABLE_DL=1
